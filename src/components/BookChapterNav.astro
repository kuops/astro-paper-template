---
import type { SidebarGroup } from "@/types/books";
import { getLocaleFromPath, getLocalizedPath, useTranslations } from "@/i18n";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import type { Locale } from "@/types/config";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

type Props = {
  bookSlug: string;
  sidebar: SidebarGroup[];
  currentSlug: string;
  titleMap?: Record<string, string>;
  hrefMap: Record<string, string>;
  sourceLocaleMap?: Record<string, Locale>;
  variant?: "desktop" | "mobile";
};

const {
  bookSlug,
  sidebar,
  currentSlug,
  titleMap = {},
  hrefMap,
  sourceLocaleMap = {},
  variant = "desktop",
} = Astro.props;
---

<nav
  class:list={["book-chapter-nav space-y-3", variant]}
  data-book-chapter-nav={bookSlug}
  aria-label={t.book.chapterNav}
>
  {
    sidebar.map(group => {
      const isActive = group.items.includes(currentSlug);
      const links = group.items.map(item => {
        const href =
          hrefMap[item] ??
          getLocalizedPath(`/books/${bookSlug}/${item}`, locale);
        const sourceLocale = sourceLocaleMap[item] ?? getLocaleFromPath(href);
        const isFallback = sourceLocale !== locale;
        const isCurrent = currentSlug === item;
        const label = titleMap[item] || item;
        return (
          <a
            href={href}
            class:list={["book-chapter-link", { active: isCurrent }]}
            aria-current={isCurrent ? "page" : undefined}
            data-current-chapter={isCurrent ? "true" : undefined}
          >
            <span class="book-chapter-label">{label}</span>
            {isFallback && (
              <span class="ms-1 flex-none text-[0.6875rem] text-foreground/45 uppercase">
                ({sourceLocale})
              </span>
            )}
          </a>
        );
      });

      if (!group.text) {
        return <div class="book-group-body ungrouped space-y-0.5">{links}</div>;
      }

      return (
        <details
          open={isActive}
          class="book-group group"
          data-book-group={group.text}
        >
          <summary class="book-group-title">
            <span>{group.text}</span>
            <IconChevronRight
              class="book-group-arrow size-4"
              aria-hidden="true"
            />
          </summary>
          <div class="book-group-body">{links}</div>
        </details>
      );
    })
  }
</nav>

<script is:inline data-astro-rerun>
  (function () {
    window.__bookChapterNavController?.abort();
    const controller = new AbortController();
    const navs = document.querySelectorAll("[data-book-chapter-nav]");

    navs.forEach(function (nav) {
      const bookSlug = nav.getAttribute("data-book-chapter-nav");
      const key = "book-sidebar:" + bookSlug;
      const groups = nav.querySelectorAll("details[data-book-group]");

      function loadState() {
        let saved = /** @type {Record<string, boolean>} */ ({});
        try {
          saved = JSON.parse(localStorage.getItem(key) || "{}");
        } catch {
          return;
        }
        groups.forEach(function (el) {
          const name = el.getAttribute("data-book-group");
          if (name && name in saved) {
            el.open = saved[name];
          }
        });
        const active = nav.querySelector("[data-current-chapter='true']");
        const parent = active?.closest("details[data-book-group]");
        if (parent) parent.open = true;
      }

      function saveState() {
        const state = {};
        groups.forEach(function (el) {
          const name = el.getAttribute("data-book-group");
          if (name) state[name] = el.open;
        });
        try {
          localStorage.setItem(key, JSON.stringify(state));
        } catch {}
      }

      groups.forEach(function (el) {
        el.addEventListener("toggle", saveState, { signal: controller.signal });
      });

      loadState();
    });

    window.__bookChapterNavController = controller;
    document.addEventListener(
      "astro:before-swap",
      function () {
        controller.abort();
      },
      { once: true, signal: controller.signal }
    );
  })();
</script>

<style>
  .book-group {
    min-width: 0;
  }
  .book-group-title {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .book-group-title:hover {
    color: var(--foreground);
    background: color-mix(in srgb, var(--foreground) 5%, transparent);
  }
  .book-group-title::-webkit-details-marker,
  .book-group-title::marker {
    display: none;
    content: "";
  }
  .book-group-arrow {
    flex-shrink: 0;
    margin-inline-start: auto;
    color: var(--accent);
    opacity: 0.75;
    transition: transform 0.2s ease;
  }
  details[open] > .book-group-title .book-group-arrow {
    transform: rotate(90deg);
  }
  .book-group-body {
    display: flex;
    flex-direction: column;
    margin-inline-start: 0.5rem;
    padding: 0.125rem 0 0.125rem 0.5rem;
    border-inline-start: 1px solid var(--border);
  }
  .book-group-body.ungrouped {
    margin-inline-start: 0;
    padding: 0;
    border-inline-start: 0;
  }
  .book-chapter-link {
    display: flex;
    min-height: 2rem;
    align-items: center;
    padding: 0.375rem 0.625rem;
    border-inline-start: 2px solid transparent;
    border-radius: 0 0.375rem 0.375rem 0;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .desktop .book-chapter-label {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .book-chapter-link:hover {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
    color: var(--accent);
  }
  .book-chapter-link.active {
    border-inline-start-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, transparent);
    color: var(--foreground);
    font-weight: 600;
  }
  .mobile .book-group-title,
  .mobile .book-chapter-link {
    min-height: 2.75rem;
  }
  .mobile .book-group-title {
    padding-block: 0.5rem;
  }
  .mobile .book-chapter-link {
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  .mobile .book-chapter-label {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
