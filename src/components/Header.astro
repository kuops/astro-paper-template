---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconLanguage from "@/assets/icons/IconLanguage.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import config from "@/config";
import {
  getAlternateLocale,
  getLocaleFromPath,
  getLocalizedPath,
  stripLocalePrefix,
  useTranslations,
} from "@/i18n";

type Props = {
  maxWidth?: string;
  alternateUrl?: string;
};

const { maxWidth, alternateUrl } = Astro.props;

const { pathname } = Astro.url;
const locale = getLocaleFromPath(pathname);
const t = useTranslations(locale);
const alternateLocale = getAlternateLocale(locale);
const targetLanguage = alternateLocale
  ? t.language.names[alternateLocale]
  : undefined;
const localizedPath = (path: string) => getLocalizedPath(path, locale);

// Remove trailing slash from current pathname if exists
const unprefixedPath = stripLocalePrefix(pathname).pathname;
const currentPath =
  unprefixedPath.endsWith("/") && unprefixedPath !== "/"
    ? unprefixedPath.slice(0, -1)
    : unprefixedPath;
const fallbackAlternatePath = currentPath.startsWith("/posts/")
  ? "/posts"
  : currentPath.startsWith("/books/")
    ? "/books"
    : currentPath === "/about"
      ? "/"
      : currentPath;
const languageHref = alternateLocale
  ? (alternateUrl ?? getLocalizedPath(fallbackAlternatePath, alternateLocale))
  : undefined;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const isCurrentPage = (path: string) => currentPath === path;
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class:list={[
    maxWidth ?? "mx-auto w-full max-w-3xl px-4",
    "flex flex-col items-center justify-between md:flex-row",
  ]}
>
  <div
    id="top-nav-wrap"
    class:list={[
      "py-4 md:py-6",
      "border-b border-border",
      "relative w-full bg-background",
      "flex items-baseline justify-between md:items-center",
    ]}
  >
    <a
      href={localizedPath("/")}
      class="absolute py-1 text-xl leading-8 font-semibold whitespace-nowrap md:static md:my-auto md:text-2xl md:leading-none"
    >
      {config.site.title}
    </a>
    <nav
      id="nav-menu"
      class="flex w-full flex-col items-center md:ms-2 md:flex-row md:justify-end md:space-x-4 md:py-0"
    >
      <button
        id="menu-btn"
        class="focus-outline flex size-12 items-center justify-center self-end md:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class:list={[
          "absolute -inset-x-4 top-full z-50 grid grid-cols-6 gap-1 border-b border-border bg-background px-4 py-3",
          "[&>li>a]:flex [&>li>a]:min-h-12 [&>li>a]:items-center [&>li>a]:px-3 [&>li>a]:font-medium [&>li>a]:hover:text-accent md:[&>li>a]:min-h-8 md:[&>li>a]:px-2 md:[&>li>a]:py-1",
          "hidden",
          "md:static md:inset-auto md:mt-0 md:flex md:w-auto md:items-center md:gap-x-3 md:gap-y-0 md:border-0 md:p-0",
        ]}
      >
        <li class="col-span-3">
          <a
            href={localizedPath("/books")}
            class:list={{ "active-nav": isActive("/books") }}
            aria-current={isCurrentPage("/books") ? "page" : undefined}
          >
            {t.nav.books}
          </a>
        </li>
        <li class="col-span-3">
          <a
            href={localizedPath("/posts")}
            class:list={{ "active-nav": isActive("/posts") }}
            aria-current={isCurrentPage("/posts") ? "page" : undefined}
          >
            {t.nav.posts}
          </a>
        </li>
        <li class="col-span-3">
          <a
            href={localizedPath("/tags")}
            class:list={{ "active-nav": isActive("/tags") }}
            aria-current={isCurrentPage("/tags") ? "page" : undefined}
          >
            {t.nav.tags}
          </a>
        </li>
        <li class="col-span-3">
          <a
            href={localizedPath("/about")}
            class:list={{ "active-nav": isActive("/about") }}
            aria-current={isCurrentPage("/about") ? "page" : undefined}
          >
            {t.nav.about}
          </a>
        </li>
        {
          config.features.showArchives && (
            <li class="col-span-3">
              <a
                href={localizedPath("/archives")}
                class:list={{ "active-nav": isActive("/archives") }}
                aria-current={isCurrentPage("/archives") ? "page" : undefined}
              >
                {t.nav.archives}
              </a>
            </li>
          )
        }
        <li
          aria-hidden="true"
          class="col-span-6 my-1 border-t border-border md:my-0 md:h-5 md:w-px md:border-s md:border-t-0"
        >
        </li>
        {
          alternateLocale && languageHref && targetLanguage && (
            <li class="col-span-2 flex items-center justify-center">
              <a
                href={languageHref}
                class="focus-outline flex min-w-12 justify-center !p-3 md:min-w-0 md:!p-1"
                title={`${t.language.switchLanguage}: ${targetLanguage}`}
                aria-label={`${t.language.switchLanguage}: ${targetLanguage}`}
                lang={alternateLocale}
                hreflang={alternateLocale}
                data-astro-reload
              >
                <IconLanguage />
              </a>
            </li>
          )
        }
        <li class="col-span-2 flex items-center justify-center">
          <button
            id="search-btn"
            class="focus-outline flex p-3 hover:text-accent md:p-1"
            title={`${t.nav.search} (Ctrl+K)`}
            aria-label={t.nav.search}
          >
            <IconSearch />
            <span class="sr-only">{t.nav.search}</span>
          </button>
        </li>
        {
          config.features.lightAndDarkMode && (
            <li class="col-span-2 flex items-center justify-center">
              <button
                id="theme-btn"
                class="focus-outline relative size-12 p-4 hover:text-accent md:size-8"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="icon-moon absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 dark:scale-0 dark:-rotate-90 [.theme-ready_&]:transition-transform [.theme-ready_&]:duration-300" />
                <IconSunHigh class="icon-sun absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 dark:scale-100 dark:rotate-0 [.theme-ready_&]:transition-transform [.theme-ready_&]:duration-300" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  let navController: AbortController | undefined;

  function toggleNav() {
    navController?.abort();
    navController = new AbortController();

    const menuBtn = document.querySelector("#menu-btn") as HTMLElement | null;
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");
    const navMenu = document.querySelector("#nav-menu");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon || !navMenu) return;

    const setOpen = (open: boolean, restoreFocus = false) => {
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute(
        "aria-label",
        open
          ? (menuBtn.dataset.labelClose ?? "Close Menu")
          : (menuBtn.dataset.labelOpen ?? "Open Menu")
      );
      menuItems.classList.toggle("hidden", !open);
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
      if (restoreFocus) menuBtn.focus();
    };

    menuBtn.addEventListener(
      "click",
      () => setOpen(menuBtn.getAttribute("aria-expanded") !== "true"),
      { signal: navController.signal }
    );
    menuItems.addEventListener(
      "click",
      event => {
        if (
          event.target instanceof Element &&
          event.target.closest("a, #search-btn")
        ) {
          setOpen(false);
        }
      },
      { signal: navController.signal }
    );
    document.addEventListener(
      "click",
      event => {
        if (
          menuBtn.getAttribute("aria-expanded") === "true" &&
          event.target instanceof Node &&
          !navMenu.contains(event.target)
        ) {
          setOpen(false);
        }
      },
      { signal: navController.signal }
    );
    document.addEventListener(
      "keydown",
      event => {
        if (
          event.key === "Escape" &&
          menuBtn.getAttribute("aria-expanded") === "true"
        ) {
          setOpen(false, true);
        }
      },
      { signal: navController.signal }
    );
  }

  toggleNav();

  function bindSearchBtn() {
    const searchBtn = document.querySelector("#search-btn");
    if (!searchBtn) return;
    searchBtn.addEventListener("click", () => {
      const modal = document.querySelector(
        "#search-modal"
      ) as HTMLDialogElement | null;
      modal?.showModal();
    });
  }
  bindSearchBtn();

  document.addEventListener("astro:after-swap", toggleNav);
  document.addEventListener("astro:after-swap", bindSearchBtn);
  document.addEventListener("astro:before-swap", () => navController?.abort());
</script>
