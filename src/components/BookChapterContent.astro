---
import { render } from "astro:content";
import BookLayout from "@/layouts/BookLayout.astro";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import type { CollectionEntry } from "astro:content";
import type { SidebarGroup } from "@/types/books";
import { getLocaleFromPath, getLocalizedPath, useTranslations } from "@/i18n";
const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

interface Props {
  chapter: CollectionEntry<"books">;
  book: string;
  bookTitle: string;
  slug: string;
  sidebar: SidebarGroup[];
  titleMap: Record<string, string>;
  hrefMap: Record<string, string>;
  prevSlug: string | null;
  nextSlug: string | null;
}

const {
  chapter,
  book,
  bookTitle,
  slug,
  sidebar,
  titleMap,
  hrefMap,
  prevSlug,
  nextSlug,
} = Astro.props;

const { Content, headings: allHeadings } = await render(chapter);
const headings = allHeadings.filter(h => h.depth >= 2 && h.depth <= 4);
---

<BookLayout
  title={chapter.data.title}
  description={chapter.data.description}
  {bookTitle}
  bookSlug={book}
  {sidebar}
  currentSlug={slug}
  {titleMap}
  {hrefMap}
  {headings}
>
  <Content />

  <hr class="my-8 border-dashed" />

  <div data-pagefind-ignore class="grid grid-cols-2 gap-3 sm:gap-6">
    {
      prevSlug ? (
        <a
          href={hrefMap[prevSlug]}
          class="flex min-h-14 w-full min-w-0 items-center gap-1 rounded-md py-2 hover:opacity-75"
        >
          <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
          <div class="min-w-0">
            <span class="text-sm text-foreground/60">
              {t.book.previousChapter}
            </span>
            <div class="truncate text-sm font-medium text-accent">
              {titleMap[prevSlug] || prevSlug}
            </div>
          </div>
        </a>
      ) : (
        nextSlug && (
          <a
            href={getLocalizedPath("/books", locale)}
            class="flex min-h-14 w-full min-w-0 items-center gap-1 rounded-md py-2 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
            <span class="text-sm font-medium text-accent">
              {t.book.backToBooks}
            </span>
          </a>
        )
      )
    }
    {
      nextSlug ? (
        <a
          href={hrefMap[nextSlug]}
          class="flex min-h-14 w-full min-w-0 items-center justify-end gap-1 rounded-md py-2 text-end hover:opacity-75"
        >
          <div class="min-w-0">
            <span class="text-sm text-foreground/60">{t.book.nextChapter}</span>
            <div class="truncate text-sm font-medium text-accent">
              {titleMap[nextSlug] || nextSlug}
            </div>
          </div>
          <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
        </a>
      ) : prevSlug ? (
        <a
          href={getLocalizedPath("/books", locale)}
          class="flex min-h-14 w-full min-w-0 items-center justify-end gap-1 rounded-md py-2 text-end hover:opacity-75"
        >
          <span class="text-sm font-medium text-accent">
            {t.book.backToBooks}
          </span>
          <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
        </a>
      ) : (
        <a
          href={getLocalizedPath("/books", locale)}
          class="col-span-2 flex min-h-14 w-full items-center justify-center gap-1 rounded-md py-2 hover:opacity-75"
        >
          <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
          <span class="text-sm font-medium text-accent">
            {t.book.backToBooks}
          </span>
        </a>
      )
    }
  </div>
</BookLayout>
