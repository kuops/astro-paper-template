---
import BookChapterNav from "@/components/BookChapterNav.astro";
import type { SidebarGroup } from "@/types/books";

type Props = {
  bookSlug: string;
  sidebar: SidebarGroup[];
  currentSlug: string;
  titleMap?: Record<string, string>;
};

const { bookSlug, sidebar, currentSlug, titleMap = {} } = Astro.props;
---

<BookChapterNav
  {bookSlug}
  {sidebar}
  {currentSlug}
  {titleMap}
  variant="desktop"
/>
