---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import config from "@/config";
import { getLocaleFromPath, useTranslations } from "@/i18n";
import { resolveLocalizedEntries } from "@/utils/localizedContent";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const posts = resolveLocalizedEntries(allPosts, "blog", config.site.lang);
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: config.posts.perPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.tagTitle}: ${tagName} | ${config.site.title}`}
  localeAlternates
>
  <Header />
  <Main
    pageTitle={[`${t.pages.tagTitle}:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`${t.pages.tagDesc} "${tagName}".`}
  >
    <h1 slot="title" transition:name={tag}>{`${t.pages.tagTitle}:${tag}`}</h1>
    <ul>
      {page.data.map(data => <Card requestedLocale={locale} {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
