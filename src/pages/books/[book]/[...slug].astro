---
import {
  getBookEntries,
  buildSidebar,
  buildTitleMap,
  getFlatItems,
  getAllBooks,
  isBookIndex,
  isGroupIndex,
  buildHrefMap,
  buildSourceLocaleMap,
  getChapterSlug,
} from "@/utils/books";
import BookChapterContent from "@/components/BookChapterContent.astro";
import config from "@/config";
import { getLocalizedPath } from "@/i18n";

export async function getStaticPaths() {
  const books = await getAllBooks();
  const paths = [];

  for (const book of books) {
    const entries = await getBookEntries(book.slug);
    for (const entry of entries) {
      if (isBookIndex(entry) || isGroupIndex(entry)) {
        continue;
      }
      const relativePath = getChapterSlug(entry);
      if (!relativePath) continue;
      paths.push({
        params: { book: book.slug, slug: relativePath },
        props: { chapter: entry, entries, bookTitle: book.title },
      });
    }
  }

  return paths;
}

const { chapter, entries, bookTitle } = Astro.props;
const { book, slug } = Astro.params;

const sidebar = buildSidebar(book!, entries);
const titleMap = buildTitleMap(entries, book!);
const hrefMap = buildHrefMap(entries, book!);
const sourceLocaleMap = buildSourceLocaleMap(entries, book!);

const flatItems = getFlatItems(sidebar);
const currentIndex = flatItems.indexOf(slug!);
const prevSlug = currentIndex > 0 ? flatItems[currentIndex - 1] : null;
const nextSlug =
  currentIndex < flatItems.length - 1 ? flatItems[currentIndex + 1] : null;

const alternateLocale = config.i18n.locales.find(
  locale => locale !== config.site.lang
);
const alternateUrl = alternateLocale
  ? getLocalizedPath(`/books/${book}/${slug}`, alternateLocale)
  : undefined;
---

<BookChapterContent
  {chapter}
  book={book!}
  {bookTitle}
  slug={slug!}
  {sidebar}
  {titleMap}
  {hrefMap}
  {sourceLocaleMap}
  {prevSlug}
  {nextSlug}
  {alternateUrl}
/>
