---
import {
  getBookEntries,
  buildSidebar,
  buildTitleMap,
  getFlatItems,
  getAllBooks,
  getFirstChapter,
  getChapterEntry,
  buildHrefMap,
  buildSourceLocaleMap,
} from "@/utils/books";
import BookChapterContent from "@/components/BookChapterContent.astro";
import config from "@/config";
import { getLocalizedPath } from "@/i18n";

export async function getStaticPaths() {
  const books = await getAllBooks();
  const paths = [];

  for (const book of books) {
    const entries = await getBookEntries(book.slug);
    const firstSlug = getFirstChapter(book.slug, entries);
    if (!firstSlug) continue;
    const chapter = getChapterEntry(entries, book.slug, firstSlug);
    if (!chapter) continue;
    paths.push({
      params: { book: book.slug },
      props: { chapter, entries, slug: firstSlug, bookTitle: book.title },
    });
  }

  return paths;
}

const { chapter, entries, slug, bookTitle } = Astro.props;
const { book } = Astro.params;

const sidebar = buildSidebar(book!, entries);
const titleMap = buildTitleMap(entries, book!);
const hrefMap = buildHrefMap(entries, book!);
const sourceLocaleMap = buildSourceLocaleMap(entries, book!);

const flatItems = getFlatItems(sidebar);
const currentIndex = flatItems.indexOf(slug!);
const prevSlug = currentIndex > 0 ? flatItems[currentIndex - 1] : null;
const nextSlug =
  currentIndex < flatItems.length - 1 ? flatItems[currentIndex + 1] : null;

const alternateLocale = config.i18n.locales.find(
  locale => locale !== config.site.lang
);
const alternateUrl = alternateLocale
  ? getLocalizedPath(`/books/${book}`, alternateLocale)
  : undefined;
---

<BookChapterContent
  {chapter}
  book={book!}
  {bookTitle}
  slug={slug!}
  {sidebar}
  {titleMap}
  {hrefMap}
  {sourceLocaleMap}
  {prevSlug}
  {nextSlug}
  indexable={false}
  {alternateUrl}
/>
