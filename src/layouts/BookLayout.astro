---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BookSidebar from "@/components/BookSidebar.astro";
import BookMobileNav from "@/components/BookMobileNav.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import ArticleEnhancements from "@/components/ArticleEnhancements.astro";
import MermaidRenderer from "@/components/MermaidRenderer.astro";
import ImageLightbox from "@/components/ImageLightbox.astro";
import config from "@/config";
import type { SidebarGroup } from "@/types/books";

type Props = {
  title: string;
  description: string;
  bookTitle: string;
  bookSlug: string;
  sidebar: SidebarGroup[];
  currentSlug: string;
  titleMap?: Record<string, string>;
  hrefMap: Record<string, string>;
  headings: { depth: number; slug: string; text: string }[];
};

const {
  title,
  description,
  bookTitle,
  bookSlug,
  sidebar,
  currentSlug,
  titleMap = {},
  hrefMap,
  headings,
} = Astro.props;
---

<Layout
  title={`${title} | ${config.site.title}`}
  description={description}
  scrollSmooth
>
  <Header maxWidth="mx-auto w-full max-w-7xl px-4" />
  <BookMobileNav
    {bookTitle}
    {bookSlug}
    {sidebar}
    {currentSlug}
    {titleMap}
    {hrefMap}
    {headings}
  />
  <main
    id="main-content"
    class="mx-auto w-full max-w-7xl px-4 py-12"
    data-pagefind-body
    data-pagefind-filter="type:book"
  >
    <div class="flex gap-8">
      <aside class="hidden w-56 flex-none lg:block">
        <div
          class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto overscroll-contain"
        >
          <BookSidebar
            {bookSlug}
            {sidebar}
            {currentSlug}
            {titleMap}
            {hrefMap}
          />
        </div>
      </aside>
      <div class="min-w-0 flex-1">
        <h1
          class="mb-8 text-[1.75rem] leading-9 font-bold text-accent sm:text-3xl"
          data-pagefind-meta="title"
        >
          {title}
        </h1>
        <article
          id="article"
          class="app-prose w-full max-w-none prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
        >
          <slot />
        </article>
      </div>
      {
        headings.length > 0 && (
          <aside class="hidden w-52 flex-none xl:block">
            <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto overscroll-contain">
              <TableOfContents {headings} />
            </div>
          </aside>
        )
      }
    </div>
    <BackToTopButton />
  </main>
  <Footer maxWidth="mx-auto w-full max-w-7xl px-4" />
</Layout>

<ArticleEnhancements />

<MermaidRenderer />

<ImageLightbox />

<style>
  @media (max-width: 63.999rem) {
    :global(#article h2),
    :global(#article h3),
    :global(#article h4) {
      scroll-margin-top: 4rem;
    }
  }
</style>
